---
import Base from "../../layouts/Base.astro";
import MeasurementList from "../../components/MeasurementList.astro";
import Contributor from "../../components/Contributor.astro";
import {
  machines, machineById, sightingsByMachine, gymById,
  headlineField, FIELD_LABELS, assetUrl, relatedMachines, machineTitle, brandSlug,
  type Machine, type Generation, type Doc,
} from "../../lib/data";

export function getStaticPaths() {
  return machines.map((m) => ({ params: { slug: m.slug }, props: { machine: m } }));
}
const { machine } = Astro.props as { machine: Machine };
const title = `${machine.brand}${machine.model ? " " + machine.model : ""}`;
const sightings = sightingsByMachine.get(machine.id) ?? [];
const latest = sightings[0];
const q = `machine=${machine.id}&slug=${machine.slug}&name=${encodeURIComponent(title)}`;
const addSightingUrl = `/contribute/sighting/?${q}`;
const addDocUrl = `/contribute/document/?${q}`;
const addLinkUrl = `/contribute/link/?${q}`;
const related = relatedMachines(machine);
const unsortedDocs: Doc[] = machine.unsorted?.documents ?? [];

// One marker per geocoded gym this machine has been sighted at.
const mapById = new Map<string, { place_id: string; name: string; lat: number; lon: number; date: string; count: number }>();
for (const s of sightings) {
  const g = gymById.get(s.place_id);
  if (g && typeof g.lat === "number" && typeof g.lon === "number") {
    const ex = mapById.get(g.id);
    if (ex) { ex.count++; if ((s.date_seen || "") > ex.date) ex.date = s.date_seen; }
    else mapById.set(g.id, { place_id: g.id, name: g.name, lat: g.lat, lon: g.lon, date: s.date_seen, count: 1 });
  }
}
const mapPoints = [...mapById.values()];

// Effective loading for a generation falls back to the nameplate's.
const genLoading = (g: Generation) => (g.loading?.length ? g.loading : machine.loading);

function renderMeasurements(measurements: Record<string, any[]> | undefined, loading?: string[]) {
  if (!measurements) return [];
  const hf = headlineField(loading);
  return Object.entries(measurements).sort(([a], [b]) => (a === hf ? -1 : b === hf ? 1 : 0));
}
---

<Base title={title} description={`Specs and sightings for the ${title}.`}>
  <div class="machine" data-pagefind-body>
    <div class="mhead">
    <p class="crumb"><a href="/">Machines</a> › <a href={`/brands/${brandSlug(machine.brand)}/`}>{machine.brand}</a> ›</p>
    <h1>{title}</h1>
    <p>
      {machine.status === "stub" && <span class="pill stub">stub</span>}
      {(machine.region ?? []).map((r) => <span class="pill">{r}</span>)}
      {(machine.loading ?? []).map((l) => <span class="pill">{l}</span>)}
      {machine.form_factor && <span class="pill">{machine.form_factor}</span>}
    </p>
    {machine.movement && <p class="muted">{machine.movement}</p>}
    {machine.model_number?.length && (
      <p class="muted">Model no.: <span class="mono">{machine.model_number.join(", ")}</span></p>
    )}
    </div>

    {assetUrl(machine.lead_photo) && (
      <aside class="media">
        <img class="lead" src={assetUrl(machine.lead_photo)} alt={machine.lead_photo?.caption ?? title} loading="lazy" onerror="this.style.display='none'" />
      </aside>
    )}

    <div class="body">
    {latest && (
      <p class="latest">
        📍 Last spotted at <a href={`/gyms/${latest.place_id}/`}>{latest.place_name}</a>
        on {latest.date_seen} — <span class="muted">may be gone.</span>
      </p>
    )}

    {(machine.generations ?? []).map((g) => {
      const loading = genLoading(g);
      const hf = headlineField(loading);
      return (
        <section class="gen">
          <h2>{g.label ?? "Generation"}{g.era ? ` · ${g.era}` : ""}</h2>
          {g.brand_owner && <p class="muted">Built by {g.brand_owner}</p>}
          {g.model_number?.length && (
            <p class="muted">Model no.: <span class="mono">{g.model_number.join(", ")}</span></p>
          )}
          {g.loading?.length && <p class="muted">Loads: {g.loading.join(", ")}{hf ? ` — leads with ${FIELD_LABELS[hf] ?? hf}` : ""}</p>}

          {renderMeasurements(g.measurements, loading).map(([field, obs]) => (
            <MeasurementList label={FIELD_LABELS[field] ?? field} observations={obs} featured={field === hf} />
          ))}
          {g.specs && Object.entries(g.specs).map(([field, obs]) => (
            field !== "dimensions" && <MeasurementList label={FIELD_LABELS[field] ?? field} observations={obs as any[]} />
          ))}

          {g.documents?.length && (
            <div class="docs">
              <h3>Documentation</h3>
              <ul>
                {g.documents.map((d) => (
                  <li>
                    <span class="pill">{d.doc_type}</span>
                    {d.url ? <a href={d.url} rel="nofollow noopener">{d.title ?? d.url}</a> : <span>{d.title ?? d.id}</span>}
                    {d.year && <span class="muted"> · {d.year}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      );
    })}

    {machine.unsorted?.measurements && Object.keys(machine.unsorted.measurements).length > 0 && (
      <section class="unsorted">
        <h2>Unsorted observations</h2>
        <p class="hole">Not yet pinned to a generation — know which one? Help identify it.</p>
        {Object.entries(machine.unsorted.measurements).map(([field, obs]) => (
          <MeasurementList label={FIELD_LABELS[field] ?? field} observations={obs as any[]} />
        ))}
      </section>
    )}

    <section class="docs-section">
      <h2>Documentation</h2>
      <p><a href={addDocUrl}>📄 Have a manual, catalog, ad, or patent? Add documentation →</a></p>
      {unsortedDocs.length > 0 && (
        <ul class="list">
          {unsortedDocs.map((d) => (
            <li>
              <span class="pill">{d.doc_type}</span>
              {d.url ? <a href={d.url} rel="nofollow noopener">{d.title ?? d.url}</a> : <span>{d.title ?? d.id}</span>}
              {d.year && <span class="muted"> · {d.year}</span>}
              {d.publisher && <span class="muted"> · {d.publisher}</span>}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="related">
      <h2>Related machines</h2>
      <p><a href={addLinkUrl}>🔗 Same family, a remake, or a rebrand? Link it →</a></p>
      {related.length > 0 && (
        <ul class="list">
          {related.map((r) => (
            <li>
              <span class="pill">{r.label}</span>
              <a href={`/machines/${r.machine.slug}/`}>{machineTitle(r.machine)}</a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="sightings">
      <h2>Spotted in the wild</h2>
      <p><a href={addSightingUrl}>📍 Seen one? Add a sighting →</a></p>

      {mapPoints.length > 0 && (
        <>
          <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
          <div id="sightings-map" class="smap"></div>
          <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
          <script is:inline define:vars={{ points: mapPoints }}>
            (function () {
              function init() {
                if (!window.L) return;
                var map = L.map("sightings-map", { scrollWheelZoom: false });
                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                  maxZoom: 19,
                  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                }).addTo(map);
                var coords = [];
                points.forEach(function (p) {
                  var m = L.marker([p.lat, p.lon]).addTo(map);
                  var div = document.createElement("div");
                  var a = document.createElement("a");
                  a.href = "/gyms/" + encodeURIComponent(p.place_id) + "/";
                  a.textContent = p.name;
                  div.appendChild(a);
                  div.appendChild(document.createElement("br"));
                  var s = document.createElement("span");
                  s.textContent = p.count > 1 ? p.count + " sightings" : "seen " + p.date;
                  div.appendChild(s);
                  m.bindPopup(div);
                  coords.push([p.lat, p.lon]);
                });
                if (coords.length === 1) map.setView(coords[0], 13);
                else map.fitBounds(coords, { padding: [30, 30] });
              }
              if (document.readyState !== "loading") init();
              else document.addEventListener("DOMContentLoaded", init);
            })();
          </script>
        </>
      )}

      {sightings.length === 0 ? (
        <p class="hole">No sightings yet.</p>
      ) : (
        <ul class="list">
          {sightings.map((s) => (
            <li>
              <a href={`/gyms/${s.place_id}/`}>{s.place_name}</a>
              <span class="muted"> · {s.date_seen} · </span><Contributor handle={s.reporter} />
              {s.serial && <span class="muted"> · S/N <span class="mono">{s.serial}</span></span>}
              {s.note && <div class="note muted">{s.note}</div>}
            </li>
          ))}
        </ul>
      )}
    </section>
    </div>
  </div>
</Base>

<style>
  .crumb { color: var(--muted); font-size: 0.85rem; margin-bottom: 0; }
  /* Mobile: single column, natural source order (header, photo, body) — unchanged. */
  .machine { display: grid; grid-template-columns: 1fr; column-gap: 1.75rem; }
  .media { margin: 0.75rem 0; }
  .lead { width: 100%; border-radius: 10px; border: 1px solid var(--line); display: block; }
  /* Desktop: header full-width on top, body left, photo in a sticky right column. */
  @media (min-width: 760px) {
    .machine { grid-template-columns: minmax(0, 1fr) 300px; align-items: start; }
    .mhead { grid-column: 1 / -1; }
    .body { grid-column: 1; grid-row: 2; }
    .media { grid-column: 2; grid-row: 2; position: sticky; top: 1rem; margin: 0; }
  }
  .latest { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 0.5rem 0.8rem; }
  section.gen { margin-top: 1.5rem; }
  .docs ul, .list { list-style: none; padding: 0; }
  .docs li { padding: 0.25rem 0; }
  .list li { padding: 0.5rem 0; border-bottom: 1px solid var(--line); }
  .note { font-size: 0.9rem; }
  .smap { height: 320px; border: 1px solid var(--line); border-radius: 10px; margin: 0.5rem 0 0.9rem; }
  .smap :global(.leaflet-popup-content a) { font-weight: 700; }
</style>
