---
import Base from "../layouts/Base.astro";
// Pagefind indexes the built site (dist/) after `astro build`, emitting
// /pagefind/*. Those assets exist in production; in `astro dev` the box is inert.
---

<Base title="Search" description="Search the Iron Archive.">
  <h1>Search</h1>
  <p class="muted">Build-time full-text search across every machine and gym page.</p>
  <div id="search"></div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (window.PagefindUI) new window.PagefindUI({ element: "#search", showSubResults: true });
    });
  </script>
</Base>
