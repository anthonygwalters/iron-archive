---
import Base from "../../layouts/Base.astro";
import { TURNSTILE_SITEKEY, DOC_TYPES } from "../../lib/config";
---

<Base title="Add documentation" description="Attach a manual, catalog, ad, or patent to a machine.">
  <h1>Add documentation</h1>
  <p class="muted" id="ctx">Attach evidence to this machine.</p>
  <p class="muted">
    <strong>Link-first:</strong> if the document already lives somewhere (archive.org,
    a manufacturer page, an existing scan), paste the link. Only upload a file for
    orphaned documents with no home — and never re-host a currently-sold machine's
    manual. It lands in the machine's <em>unsorted</em> bucket for review.
  </p>

  <form id="f" class="form">
    <input type="hidden" name="machine_id" id="machine_id" />
    <input type="hidden" name="slug" id="slug" />

    <label>Type <span class="req">*</span>
      <select name="doc_type" required>
        {DOC_TYPES.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>

    <label>Link (URL)
      <input name="url" type="url" placeholder="https://archive.org/… (preferred)" />
    </label>
    <p class="muted or">— or, only if it's orphaned —</p>
    <label>Upload a file
      <input type="file" name="file" accept="application/pdf,image/*" />
    </label>

    <label>Title
      <input name="title" placeholder="e.g. 1998 Owner's Manual" />
    </label>
    <label>Publisher
      <input name="publisher" placeholder="e.g. Nautilus" />
    </label>
    <label>Year
      <input name="year" inputmode="numeric" placeholder="e.g. 1998" />
    </label>
    <label>Your handle (optional)
      <input name="handle" placeholder="github user or a name" />
    </label>

    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>
    <button type="submit">Submit for review</button>
    <p id="result" class="result" hidden></p>
  </form>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    import { SUBMIT_URL } from "../../lib/config";
    const params = new URLSearchParams(location.search);
    (document.getElementById("machine_id") as HTMLInputElement).value = params.get("machine") || "";
    (document.getElementById("slug") as HTMLInputElement).value = params.get("slug") || "";
    const name = params.get("name") || "this machine";
    document.getElementById("ctx")!.textContent = `Attach a manual, catalog, ad, or patent to ${name}.`;

    const form = document.getElementById("f") as HTMLFormElement;
    const result = document.getElementById("result") as HTMLElement;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button")!;
      btn.disabled = true;
      result.hidden = false;
      result.textContent = "Submitting…";
      try {
        const res = await fetch(`${SUBMIT_URL}/documents`, { method: "POST", body: new FormData(form) });
        const data = await res.json();
        if (res.ok && data.pr) {
          result.innerHTML = `Thanks! Up for review: <a href="${data.pr}" target="_blank" rel="noopener">view the pull request</a>.`;
          form.reset();
        } else {
          result.textContent = `Couldn't submit: ${data.error || res.status}`;
          btn.disabled = false;
        }
      } catch (err) {
        result.textContent = `Network error: ${err}`;
        btn.disabled = false;
      }
    });
  </script>
</Base>

<style>
  .form { max-width: 560px; display: grid; gap: 1rem; margin-top: 1rem; }
  label { display: grid; gap: 0.3rem; font-weight: 600; font-size: 0.95rem; }
  input, select { font: inherit; padding: 0.5rem; border: 1px solid var(--line); border-radius: 6px; background: var(--card); color: var(--ink); }
  .or { text-align: center; margin: -0.4rem 0; font-size: 0.85rem; }
  .req { color: var(--accent); }
  button { font: inherit; font-weight: 700; padding: 0.6rem 1rem; border: 0; border-radius: 8px; background: var(--accent); color: #fff; cursor: pointer; width: fit-content; }
  button:disabled { opacity: 0.6; cursor: default; }
  .result { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.8rem; }
</style>
