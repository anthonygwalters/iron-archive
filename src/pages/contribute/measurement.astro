---
import Base from "../../layouts/Base.astro";
import { TURNSTILE_SITEKEY, MEASURED_FIELDS, UNITS, CONFIDENCE } from "../../lib/config";
---

<Base title="Add a measurement" description="Submit a field measurement for a machine.">
  <h1>Add a measurement</h1>
  <p class="muted" id="ctx">Record a reading for this machine.</p>
  <p class="muted">
    Per the <a href="https://github.com/anthonygwalters/iron-archive/blob/main/docs/protocol.md">protocol</a>:
    a hanging scale, a <strong>stated ROM position</strong>, and up to three trials
    recorded individually (never pre-averaged). It lands in the machine's
    <em>unsorted</em> bucket for review.
  </p>

  <form id="f" class="form">
    <input type="hidden" name="machine_id" id="machine_id" />
    <input type="hidden" name="slug" id="slug" />

    <label>What did you measure? <span class="req">*</span>
      <select name="field" id="field" required>
        {MEASURED_FIELDS.map((f) => <option value={f.value}>{f.label}</option>)}
      </select>
    </label>

    <label>ROM position <span class="req">*</span>
      <input name="rom" required placeholder="e.g. pin 5, full contraction" />
    </label>

    <fieldset>
      <legend>Trials <span class="req">*</span></legend>
      <div class="trials">
        <input name="trial1" inputmode="decimal" placeholder="trial 1" required />
        <input name="trial2" inputmode="decimal" placeholder="trial 2" />
        <input name="trial3" inputmode="decimal" placeholder="trial 3" />
      </div>
    </fieldset>

    <div class="row">
      <label>Unit
        <select name="unit" id="unit">
          {UNITS.map((u) => <option value={u}>{u}</option>)}
        </select>
      </label>
      <label>Confidence
        <select name="confidence">
          {CONFIDENCE.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
    </div>

    <label>Source
      <input name="source" placeholder="e.g. crane-scale, luggage-scale, manual" />
    </label>
    <label>Your handle (optional)
      <input name="handle" placeholder="github user or a name" />
    </label>

    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>
    <button type="submit">Submit for review</button>
    <p id="result" class="result" hidden></p>
  </form>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    import { SUBMIT_URL } from "../../lib/config";
    const params = new URLSearchParams(location.search);
    (document.getElementById("machine_id") as HTMLInputElement).value = params.get("machine") || "";
    (document.getElementById("slug") as HTMLInputElement).value = params.get("slug") || "";
    const name = params.get("name") || "this machine";
    document.getElementById("ctx")!.textContent = `Record a reading for ${name}.`;

    const fieldSel = document.getElementById("field") as HTMLSelectElement;
    const unitSel = document.getElementById("unit") as HTMLSelectElement;
    const preset = params.get("field");
    if (preset) fieldSel.value = preset;
    // Sensible default unit: ratio for leverage/pulley, else lb.
    function syncUnit() {
      const ratioish = fieldSel.value === "leverage" || fieldSel.value === "pulley_ratio";
      unitSel.value = ratioish ? "ratio" : "lb";
    }
    syncUnit();
    fieldSel.addEventListener("change", syncUnit);

    const form = document.getElementById("f") as HTMLFormElement;
    const result = document.getElementById("result") as HTMLElement;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button")!;
      btn.disabled = true;
      result.hidden = false;
      result.textContent = "Submitting…";
      try {
        const fd = new FormData(form);
        try { const s = localStorage.getItem("ia_session"); if (s) fd.append("session", s); } catch {}
        const res = await fetch(`${SUBMIT_URL}/measurements`, { method: "POST", body: fd });
        const data = await res.json();
        if (res.ok && data.pr) {
          result.innerHTML = `Thanks! Up for review: <a href="${data.pr}" target="_blank" rel="noopener">view the pull request</a>.`;
          form.reset();
          syncUnit();
        } else {
          result.textContent = `Couldn't submit: ${data.error || res.status}`;
          btn.disabled = false;
        }
      } catch (err) {
        result.textContent = `Network error: ${err}`;
        btn.disabled = false;
      }
    });
  </script>
</Base>

<style>
  .form { max-width: 560px; display: grid; gap: 1rem; margin-top: 1rem; }
  label { display: grid; gap: 0.3rem; font-weight: 600; font-size: 0.95rem; }
  input, select { font: inherit; padding: 0.5rem; border: 1px solid var(--line); border-radius: 6px; background: var(--card); color: var(--ink); }
  fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.8rem; }
  legend { font-weight: 700; font-size: 0.9rem; padding: 0 0.3rem; }
  .trials { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .req { color: var(--accent); }
  button { font: inherit; font-weight: 700; padding: 0.6rem 1rem; border: 0; border-radius: 8px; background: var(--accent); color: #fff; cursor: pointer; width: fit-content; }
  button:disabled { opacity: 0.6; cursor: default; }
  .result { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.8rem; }
</style>
