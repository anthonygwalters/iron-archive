---
import Base from "../../layouts/Base.astro";
import { TURNSTILE_SITEKEY, REGIONS, LOADINGS, MECHANISMS } from "../../lib/config";
---

<Base title="Add a machine" description="Submit a strength-training machine to the Iron Archive.">
  <h1>Add a machine</h1>
  <p class="muted">
    A photo and a brand is enough — it becomes a <strong>stub</strong> others can add
    facts to. Your submission opens a pull request for review; nothing publishes
    automatically.
  </p>

  <form id="f" class="form">
    <label>Brand <span class="req">*</span>
      <input name="brand" required autocomplete="off" />
    </label>
    <label>Model
      <input name="model" autocomplete="off" placeholder="best guess is fine" />
    </label>

    <fieldset>
      <legend>What it works</legend>
      {REGIONS.map((r) => (
        <label class="chk"><input type="checkbox" name="region" value={r} /> {r}</label>
      ))}
    </fieldset>

    <fieldset>
      <legend>How it loads</legend>
      {LOADINGS.map((l) => (
        <label class="chk"><input type="checkbox" name="loading" value={l} /> {l}</label>
      ))}
    </fieldset>

    <label>Mechanism
      <select name="mechanism">
        <option value="">—</option>
        {MECHANISMS.map((f) => <option value={f}>{f}</option>)}
      </select>
    </label>

    <label>Movement / notes
      <input name="movement" placeholder="e.g. iso-lateral incline press" />
    </label>

    <label>Model number(s)
      <input name="model_number" placeholder="manufacturer part # if known, comma-separated" />
    </label>

    <label>Photo <span class="req">*</span>
      <input type="file" name="photo" accept="image/*" required />
    </label>

    <label>Your handle (optional)
      <input name="handle" placeholder="github user or a name" />
    </label>

    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>

    <button type="submit">Submit for review</button>
    <p id="result" class="result" hidden></p>
  </form>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    import { SUBMIT_URL } from "../../lib/config";
    const form = document.getElementById("f") as HTMLFormElement;
    const result = document.getElementById("result") as HTMLElement;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button")!;
      btn.disabled = true;
      result.hidden = false;
      result.textContent = "Submitting…";
      try {
        const fd = new FormData(form);
        try { const s = localStorage.getItem("ia_session"); if (s) fd.append("session", s); } catch {}
        const res = await fetch(`${SUBMIT_URL}/machines`, { method: "POST", body: fd });
        const data = await res.json();
        if (res.ok && data.pr) {
          result.innerHTML = `Thanks! Your submission is up for review: <a href="${data.pr}" target="_blank" rel="noopener">view the pull request</a>.`;
          form.reset();
        } else {
          result.textContent = `Couldn't submit: ${data.error || res.status}`;
          btn.disabled = false;
        }
      } catch (err) {
        result.textContent = `Network error: ${err}`;
        btn.disabled = false;
      }
    });
  </script>
</Base>

<style>
  .form { max-width: 560px; display: grid; gap: 1rem; margin-top: 1rem; }
  label { display: grid; gap: 0.3rem; font-weight: 600; font-size: 0.95rem; }
  input[type="text"], input:not([type]), input[type="file"], select {
    font: inherit; padding: 0.5rem; border: 1px solid var(--line); border-radius: 6px;
    background: var(--card); color: var(--ink);
  }
  fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.8rem; }
  legend { font-weight: 700; font-size: 0.9rem; padding: 0 0.3rem; }
  .chk { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 400; margin: 0.15rem 0.8rem 0.15rem 0; }
  .req { color: var(--accent); }
  button { font: inherit; font-weight: 700; padding: 0.6rem 1rem; border: 0; border-radius: 8px; background: var(--accent); color: #fff; cursor: pointer; width: fit-content; }
  button:disabled { opacity: 0.6; cursor: default; }
  .result { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.8rem; }
</style>
