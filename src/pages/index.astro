---
import Base from "../layouts/Base.astro";
import { machines, contributors, headlineField, FIELD_LABELS } from "../lib/data";

const board = [...contributors.entries()]
  .map(([login, d]) => ({
    login,
    machines: d.machines.length,
    sightings: d.sightings.length,
    documents: d.documents.length,
    total: d.machines.length + d.sightings.length + d.documents.length,
  }))
  .sort((a, b) => b.total - a.total || a.login.localeCompare(b.login))
  .slice(0, 10);

const breakdown = (b: { machines: number; sightings: number; documents: number }) =>
  [
    b.machines && `${b.machines} machine${b.machines === 1 ? "" : "s"}`,
    b.sightings && `${b.sightings} sighting${b.sightings === 1 ? "" : "s"}`,
    b.documents && `${b.documents} document${b.documents === 1 ? "" : "s"}`,
  ]
    .filter(Boolean)
    .join(" · ");
---

<Base description="A public reference for strength-training machine specifications, especially discontinued models where no manufacturer documentation survives.">
  <h1>Iron Archive</h1>
  <p class="lede">
    The specs nobody publishes — <strong>starting weight</strong>,
    <strong>leverage ratio</strong>, the real load on the muscle — for the
    strength-training machines the manuals forgot. Field-measured, openly sourced,
    and never averaged away.
  </p>

  <p><a href="/contribute/machine/">+ Add a machine</a></p>

  {machines.length === 0 ? (
    <p class="hole">No records yet — be the first to add one.</p>
  ) : (
    <>
      <h2>{machines.length} machine{machines.length === 1 ? "" : "s"}</h2>
      <ul class="list">
        {machines.map((m) => {
          const hf = headlineField(m.loading);
          return (
            <li>
              <a href={`/machines/${m.slug}/`}>{m.brand}{m.model ? ` ${m.model}` : ""}</a>
              {m.status === "stub" && <span class="pill stub">stub</span>}
              {(m.region ?? []).map((r) => <span class="pill">{r}</span>)}
              {hf && <span class="lead-fact">leads with {FIELD_LABELS[hf] ?? hf}</span>}
            </li>
          );
        })}
      </ul>
    </>
  )}

  {board.length > 0 && (
    <section class="board">
      <h2>🏆 Top contributors</h2>
      <ol class="lb">
        {board.map((b) => (
          <li>
            <a href={`/contributors/${b.login}/`}>@{b.login}</a>
            <span class="total">· {b.total} total</span>
            <div class="muted breakdown">{breakdown(b)}</div>
          </li>
        ))}
      </ol>
    </section>
  )}
</Base>

<style>
  .lede { font-size: 1.1rem; color: var(--ink); max-width: 60ch; }
  ul.list { list-style: none; padding: 0; }
  ul.list li { padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  ul.list a { font-weight: 700; font-size: 1.05rem; text-decoration: none; margin-right: 0.5rem; }
  .lead-fact { color: var(--muted); font-size: 0.8rem; margin-left: 0.4rem; }
  .board { margin-top: 2.2rem; }
  ol.lb { padding-left: 1.5rem; margin: 0; }
  ol.lb li { padding: 0.5rem 0; border-bottom: 1px solid var(--line); }
  ol.lb a { font-weight: 700; margin-right: 0.4rem; }
  .total { color: var(--muted); font-size: 0.85rem; }
  .breakdown { font-size: 0.85rem; margin-top: 0.1rem; }
</style>
