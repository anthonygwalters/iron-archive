---
import Base from "../../layouts/Base.astro";
import {
  brands, sightingsByMachine, headlineField, FIELD_LABELS, machineTitle, type Brand,
} from "../../lib/data";

export function getStaticPaths() {
  return brands.map((b) => ({ params: { brand: b.slug }, props: { brand: b } }));
}
const { brand } = Astro.props as { brand: Brand };
const count = brand.machines.length;
---

<Base title={brand.name} description={`Strength-training machines by ${brand.name} in the Iron Archive.`}>
  <div data-pagefind-body>
    <p class="crumb"><a href="/brands/">Brands</a> ›</p>
    <h1>{brand.name}</h1>
    <p class="muted">{count} machine{count === 1 ? "" : "s"} in the archive</p>

    <ul class="list">
      {brand.machines.map((m) => {
        const hf = headlineField(m.loading);
        const sightings = (sightingsByMachine.get(m.id) ?? []).length;
        return (
          <li>
            <a href={`/machines/${m.slug}/`}>{machineTitle(m)}</a>
            {m.status === "stub" && <span class="pill stub">stub</span>}
            {(m.region ?? []).map((r) => <span class="pill">{r}</span>)}
            {hf && <span class="muted lead-fact">leads with {FIELD_LABELS[hf] ?? hf}</span>}
            {sightings > 0 && <span class="muted"> · {sightings} sighting{sightings === 1 ? "" : "s"}</span>}
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .crumb { font-size: 0.85rem; margin-bottom: 0; }
  ul.list { list-style: none; padding: 0; }
  ul.list li { padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  ul.list a { font-weight: 700; font-size: 1.05rem; margin-right: 0.5rem; }
  .lead-fact { font-size: 0.8rem; margin-left: 0.4rem; }
</style>
